{
  "expo": {
    "name": "NurCake POS",
    "slug": "nurcake-pos",
    "owner": "izanmaizan",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.izanmaizan.nurcakepos"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "scheme": "nurcake-pos",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e611a4b-4006-4452-9194-d604a85d278a"
      }
    }
  }
}
